{
  "openapi": "3.0.2",
  "info": {
    "title": "Business Partner Relationship (Version 2)",
    "version": "2.0.0",
    "description": "This service enables you to create, read, update, and delete business partner relationships for a specific supplier user ID. A business partner relationship maps the included supplier user ID to additional business entities, enabling the user ID to act on behalf of any business entity that it is mapped to."
  },
  "x-sap-api-type": "ODATAV4",
  "x-odata-version": "4.01",
  "x-sap-shortText": "Creates, reads, updates and deletes business partner relationships.",
  "x-sap-hub-capabilities": {
    "try-out": false
  },
  "servers": [
    {
      "url": "https://{hostUrl}/sap/opu/odata4/bids/api_supplierbpassign/srvd_a2x/bids/api_supplierbpassign/0001",
      "description": "Production URL.",
      "variables": {
        "hostUrl": {
          "default": "e1b518a2-8e62-46a5-a221-29c36589a1e0.abap.eu10.hana.ondemand.com"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Business Partner Relationships",
      "description": "Operations on supplier user records with default Business Partner assignment"
    },
    {
      "name": "Business Partner Linkages",
      "description": "Operations on individual linked Business Partner assignments for a supplier user"
    }
  ],
  "paths": {
    "/SupplierBPAssignment": {
      "get": {
        "summary": "Retrieves supplier Business Partner assignments.",
        "description": "Retrieves supplier users matching one or more filter criteria. Supports pagination using OData query options such as $top, $skip, $filter, $expand, $select, $orderby, and $count.",
        "tags": ["Business Partner Relationships"],
        "operationId": "listSupplierBPAssignments",
        "parameters": [
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter the collection based on a boolean expression (e.g., BusinessPartner eq '9980001321', BusinessPartnerEmail eq 'sreeja@sap.com'). See [$filter](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionfilter)",
            "example": "BusinessPartner eq '9980001321'"
          },
          {
            "name": "$select",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Select specific properties to return. See [$select](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionselect)",
            "example": "BusinessPartnerUUID,BusinessPartner,DefaultBusinessPartner"
          },
          {
            "name": "$expand",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Expand related entities to include linked Business Partner assignments. See [$expand](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionexpand)",
            "example": "_MapBPToSupplierUser"
          },
          {
            "name": "$skip",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 0 },
            "description": "Skip the first N records in the result set for pagination. See [$skip](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionskip)",
            "example": 0
          },
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Return only the first N records from the result set. See [$top](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptiontop)",
            "example": 50
          },
          {
            "name": "$count",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "Include the total count of records in the response. See [$count](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptioncount)",
            "example": true
          },
          {
            "name": "$orderby",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Order items by property values. See [$orderby](https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionorderby)",
            "example": "BusinessPartnerUUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved supplier Business Partner assignments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "@odata.count": { "type": "integer" },
                    "value": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SupplierBPAssignment" }
                    }
                  }
                },
                "example": {
                  "value": [
                    {
                      "BusinessPartnerUUID": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                      "BusinessPartner": "9980001321",
                      "UserID": "CB9980001321",
                      "BusinessPartnerFirstName": "Sreeja",
                      "BusinessPartnerLastName": "A",
                      "BusinessPartnerEmail": "Sreeja.A@sap.com",
                      "DefaultBusinessPartner": "472",
                      "DefaultBusinessPartnerName": "472_Default_BP",
                      "IsMarkedForArchiving": false,
                      "LogicalSystem": "",
                      "CreatedAt": "2026-07-28T10:38:29.56031Z",
                      "CreatedBy": "CB9980001321",
                      "LastChangedAt": "2026-07-28T10:45:24.96866Z",
                      "LastChangedBy": "CB9980001321"
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "Creates a supplier Business Partner assignment.",
        "description": "Creates a new supplier user record with a default Business Partner assignment and optionally one or more linked Business Partner assignments in a single deep insert request. The system auto-generates BusinessPartnerUUID and auto-fills UserID, FirstName, LastName, Email from the employee app. Linkages are optional — a user record can be created without any linked Business Partners.",
        "tags": ["Business Partner Relationships"],
        "operationId": "createSupplierBPAssignment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SupplierBPAssignmentCreate" },
              "examples": {
                "withLinkages": {
                  "summary": "Create user with Business Partner linkages",
                  "value": {
                    "BusinessPartner": "9980001321",
                    "DefaultBusinessPartner": "472",
                    "DefaultBusinessPartnerName": "472_Default_BP",
                    "_MapBPToSupplierUser": [
                      {
                        "Linkedbusinesspartner": "100",
                        "Linkedbusinesspartnername": "100_MBP",
                        "LogicalSystem": "QVLCLNT914"
                      },
                      {
                        "Linkedbusinesspartner": "ACME",
                        "Linkedbusinesspartnername": "ACME_MBP",
                        "LogicalSystem": "QVLCLNT914"
                      }
                    ]
                  }
                },
                "withoutLinkages": {
                  "summary": "Create user without linkages",
                  "value": {
                    "BusinessPartner": "9980001500",
                    "DefaultBusinessPartner": "313",
                    "DefaultBusinessPartnerName": "313_Default_BP"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Supplier Business Partner assignment created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupplierBPAssignment" },
                "example": {
                  "BusinessPartnerUUID": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                  "BusinessPartner": "9980001321",
                  "UserID": "CB9980001321",
                  "BusinessPartnerFirstName": "Sreeja",
                  "BusinessPartnerLastName": "A",
                  "BusinessPartnerEmail": "Sreeja.A@sap.com",
                  "DefaultBusinessPartner": "472",
                  "DefaultBusinessPartnerName": "472_Default_BP",
                  "IsMarkedForArchiving": false,
                  "LogicalSystem": "",
                  "CreatedAt": "2026-07-28T10:38:29.56031Z",
                  "CreatedBy": "CB9980001321",
                  "LastChangedAt": "2026-07-28T10:38:29.56031Z",
                  "LastChangedBy": "CB9980001321",
                  "_MapBPToSupplierUser": [
                    {
                      "Linkedbusinesspartneruuid": "321c3f01-5d3a-1fe1-a2ce-0f07df5e67e6",
                      "Businesspartneruuid": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                      "Linkedbusinesspartner": "100",
                      "Linkedbusinesspartnername": "100_MBP",
                      "LogicalSystem": "QVLCLNT914",
                      "CreatedAt": "2026-07-28T10:38:29.56031Z",
                      "CreatedBy": "CB9980001321",
                      "LastChangedAt": "2026-07-28T10:38:29.56031Z",
                      "LastChangedBy": "CB9980001321"
                    },
                    {
                      "Linkedbusinesspartneruuid": "321c3f01-5d3a-1fe1-a2ce-0f07df5e87e6",
                      "Businesspartneruuid": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                      "Linkedbusinesspartner": "ACME",
                      "Linkedbusinesspartnername": "ACME_MBP",
                      "LogicalSystem": "QVLCLNT914",
                      "CreatedAt": "2026-07-28T10:38:29.56031Z",
                      "CreatedBy": "CB9980001321",
                      "LastChangedAt": "2026-07-28T10:38:29.56031Z",
                      "LastChangedBy": "CB9980001321"
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/SupplierBPAssignment({BusinessPartnerUUID})": {
      "get": {
        "summary": "Retrieves a single supplier Business Partner assignment.",
        "description": "Retrieves a specific supplier user record by its UUID. Use $expand=_MapBPToSupplierUser to include all linked Business Partner assignments. To look up by business partner number, use GET /SupplierBPAssignment?$filter=BusinessPartner eq '{bp_number}'.",
        "tags": ["Business Partner Relationships"],
        "operationId": "getSupplierBPAssignment",
        "parameters": [
          { "$ref": "#/components/parameters/BusinessPartnerUUID" },
          {
            "name": "$expand",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "_MapBPToSupplierUser"
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved supplier Business Partner assignment.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupplierBPAssignment" },
                "example": {
                  "BusinessPartnerUUID": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                  "BusinessPartner": "9980001321",
                  "UserID": "CB9980001321",
                  "BusinessPartnerFirstName": "Sreeja",
                  "BusinessPartnerLastName": "A",
                  "BusinessPartnerEmail": "Sreeja.A@sap.com",
                  "DefaultBusinessPartner": "472",
                  "DefaultBusinessPartnerName": "472_Default_BP",
                  "IsMarkedForArchiving": false,
                  "LogicalSystem": "",
                  "CreatedAt": "2026-07-28T10:38:29.56031Z",
                  "CreatedBy": "CB9980001321",
                  "LastChangedAt": "2026-07-28T10:45:24.96866Z",
                  "LastChangedBy": "CB9980001321"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "summary": "Updates a supplier Business Partner assignment.",
        "description": "Updates editable fields on the supplier user header record. Updatable fields: DefaultBusinessPartner, DefaultBusinessPartnerName. Fields like BusinessPartnerFirstName, LastName, Email are read-only (derived from employee app) and silently ignored if sent. BusinessPartner throws an error if update is attempted.",
        "tags": ["Business Partner Relationships"],
        "operationId": "updateSupplierBPAssignment",
        "parameters": [
          { "$ref": "#/components/parameters/BusinessPartnerUUID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SupplierBPAssignmentUpdate" },
              "example": {
                "DefaultBusinessPartner": "999",
                "DefaultBusinessPartnerName": "999_Updated_BP"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supplier Business Partner assignment updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupplierBPAssignment" },
                "example": {
                  "BusinessPartnerUUID": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                  "BusinessPartner": "9980001321",
                  "UserID": "CB9980001321",
                  "BusinessPartnerFirstName": "Sreeja",
                  "BusinessPartnerLastName": "A",
                  "BusinessPartnerEmail": "Sreeja.A@sap.com",
                  "DefaultBusinessPartner": "999",
                  "DefaultBusinessPartnerName": "999_Updated_BP",
                  "IsMarkedForArchiving": false,
                  "LogicalSystem": "",
                  "CreatedAt": "2026-07-28T10:38:29.56031Z",
                  "CreatedBy": "CB9980001321",
                  "LastChangedAt": "2026-07-28T11:10:00.000000Z",
                  "LastChangedBy": "BPREL_API_USER"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Deletes a supplier user and all linked Business Partner assignments.",
        "description": "Deletes the supplier user record and cascades deletion to all associated linked Business Partner assignments. This operation cannot be undone. Subsequent GET returns empty result or 404.",
        "tags": ["Business Partner Relationships"],
        "operationId": "deleteSupplierBPAssignment",
        "parameters": [
          { "$ref": "#/components/parameters/BusinessPartnerUUID" }
        ],
        "responses": {
          "204": { "description": "Supplier Business Partner assignment and all linkages deleted successfully." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/SupplierBPAssignment({BusinessPartnerUUID})/_MapBPToSupplierUser": {
      "post": {
        "summary": "Adds a linked Business Partner assignment to an existing supplier user.",
        "description": "Creates a new linked Business Partner assignment for an existing supplier user. All three fields (Linkedbusinesspartner, Linkedbusinesspartnername, LogicalSystem) are mandatory. The system auto-generates Linkedbusinesspartneruuid.",
        "tags": ["Business Partner Linkages"],
        "operationId": "createLinkedBPAssignment",
        "parameters": [
          { "$ref": "#/components/parameters/BusinessPartnerUUID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LinkedBPAssignmentCreate" },
              "example": {
                "Linkedbusinesspartner": "2050",
                "Linkedbusinesspartnername": "Siemens",
                "LogicalSystem": "QVLCLNT914"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Linked Business Partner assignment created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LinkedBPAssignment" },
                "example": {
                  "Linkedbusinesspartneruuid": "4e87482e-55a2-1fd1-93a4-282e4fe4b48d",
                  "Businesspartneruuid": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                  "Linkedbusinesspartner": "2050",
                  "Linkedbusinesspartnername": "Siemens",
                  "LogicalSystem": "QVLCLNT914",
                  "CreatedAt": "2026-07-28T11:05:00.000000Z",
                  "CreatedBy": "BPREL_API_USER",
                  "LastChangedAt": "2026-07-28T11:05:00.000000Z",
                  "LastChangedBy": "BPREL_API_USER"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/LinkedBPAssignment(Linkedbusinesspartneruuid={Linkedbusinesspartneruuid},Businesspartneruuid={Businesspartneruuid})": {
      "patch": {
        "summary": "Updates a linked Business Partner assignment.",
        "description": "Updates editable fields on an existing linked Business Partner assignment. Updatable fields: Linkedbusinesspartner, Linkedbusinesspartnername, LogicalSystem. Note: LogicalSystem must be a valid value from the configured logical systems.",
        "tags": ["Business Partner Linkages"],
        "operationId": "updateLinkedBPAssignment",
        "parameters": [
          { "$ref": "#/components/parameters/Linkedbusinesspartneruuid" },
          { "$ref": "#/components/parameters/Businesspartneruuid" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LinkedBPAssignmentUpdate" },
              "example": {
                "Linkedbusinesspartner": "101",
                "Linkedbusinesspartnername": "100_MBP_Updated",
                "LogicalSystem": "QVLCLNT915"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linked Business Partner assignment updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LinkedBPAssignment" },
                "example": {
                  "Linkedbusinesspartneruuid": "321c3f01-5d3a-1fe1-a2ce-0f07df5e67e6",
                  "Businesspartneruuid": "321c3f01-5d3a-1fe1-a2ce-0f07df5e47e6",
                  "Linkedbusinesspartner": "101",
                  "Linkedbusinesspartnername": "100_MBP_Updated",
                  "LogicalSystem": "QVLCLNT915",
                  "CreatedAt": "2026-07-28T10:38:29.56031Z",
                  "CreatedBy": "CB9980001321",
                  "LastChangedAt": "2026-07-28T11:15:00.000000Z",
                  "LastChangedBy": "BPREL_API_USER"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Deletes a single linked Business Partner assignment.",
        "description": "Removes a specific linked Business Partner assignment from a supplier user. The header record and other linkages remain intact.",
        "tags": ["Business Partner Linkages"],
        "operationId": "deleteLinkedBPAssignment",
        "parameters": [
          { "$ref": "#/components/parameters/Linkedbusinesspartneruuid" },
          { "$ref": "#/components/parameters/Businesspartneruuid" }
        ],
        "responses": {
          "204": { "description": "Linked Business Partner assignment deleted successfully." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SupplierBPAssignment": {
        "type": "object",
        "description": "Represents a supplier user with their default Business Partner assignment.",
        "properties": {
          "BusinessPartnerUUID": { "type": "string", "format": "uuid", "description": "System-generated unique identifier for the supplier user record." },
          "BusinessPartner": { "type": "string", "maxLength": 10, "description": "Business Partner number of the supplier user. Primary business key for lookup via $filter." },
          "UserID": { "type": "string", "maxLength": 12, "description": "System user ID. Auto-populated from employee app. Read-only." },
          "BusinessPartnerFirstName": { "type": "string", "maxLength": 80, "description": "First name. Read from employee app at runtime. Read-only — silently ignored if sent." },
          "BusinessPartnerLastName": { "type": "string", "maxLength": 80, "description": "Last name. Read from employee app at runtime. Read-only — silently ignored if sent." },
          "BusinessPartnerEmail": { "type": "string", "maxLength": 241, "description": "Email. Read from employee app at runtime. Read-only — silently ignored if sent." },
          "DefaultBusinessPartner": { "type": "string", "maxLength": 40, "description": "Default Business Partner assigned to the supplier user." },
          "DefaultBusinessPartnerName": { "type": "string", "maxLength": 80, "description": "Name of the default Business Partner." },
          "IsMarkedForArchiving": { "type": "boolean", "description": "Archiving flag. Read from employee app. Read-only." },
          "LogicalSystem": { "type": "string", "maxLength": 10, "description": "Header-level logical system field." },
          "CreatedAt": { "type": "string", "format": "date-time", "description": "Creation timestamp. Auto-set. Read-only." },
          "CreatedBy": { "type": "string", "maxLength": 12, "description": "Created by user. Auto-set. Read-only." },
          "LastChangedAt": { "type": "string", "format": "date-time", "description": "Last modification timestamp. Auto-updated. Read-only." },
          "LastChangedBy": { "type": "string", "maxLength": 12, "description": "Last modified by user. Auto-updated. Read-only." },
          "_MapBPToSupplierUser": {
            "type": "array",
            "description": "Collection of linked Business Partner assignments.",
            "items": { "$ref": "#/components/schemas/LinkedBPAssignment" }
          }
        }
      },
      "SupplierBPAssignmentCreate": {
        "type": "object",
        "description": "Payload for creating a new supplier Business Partner assignment. Linkages are optional.",
        "required": ["BusinessPartner", "DefaultBusinessPartner", "DefaultBusinessPartnerName"],
        "properties": {
          "BusinessPartner": { "type": "string", "maxLength": 10, "description": "Business Partner number. Must be a valid business user." },
          "DefaultBusinessPartner": { "type": "string", "maxLength": 40, "description": "Default Business Partner to assign." },
          "DefaultBusinessPartnerName": { "type": "string", "maxLength": 80, "description": "Name of the default Business Partner." },
          "_MapBPToSupplierUser": {
            "type": "array",
            "description": "Optional linked Business Partner assignments. Can be omitted to create user without linkages.",
            "items": { "$ref": "#/components/schemas/LinkedBPAssignmentCreate" }
          }
        }
      },
      "SupplierBPAssignmentUpdate": {
        "type": "object",
        "description": "Payload for updating header. Only send the fields you want to change.",
        "properties": {
          "DefaultBusinessPartner": { "type": "string", "maxLength": 40 },
          "DefaultBusinessPartnerName": { "type": "string", "maxLength": 80 }
        }
      },
      "LinkedBPAssignment": {
        "type": "object",
        "description": "Represents an individual linked Business Partner assignment.",
        "properties": {
          "Linkedbusinesspartneruuid": { "type": "string", "format": "uuid", "description": "System-generated UUID for this linkage." },
          "Businesspartneruuid": { "type": "string", "format": "uuid", "description": "UUID of the parent supplier user record." },
          "Linkedbusinesspartner": { "type": "string", "maxLength": 10, "description": "Linked Business Partner number. Updatable." },
          "Linkedbusinesspartnername": { "type": "string", "maxLength": 80, "description": "Name of the linked Business Partner. Updatable." },
          "LogicalSystem": { "type": "string", "maxLength": 10, "description": "Logical system identifier. Must be a valid configured value. Updatable." },
          "CreatedAt": { "type": "string", "format": "date-time", "description": "Creation timestamp. Read-only." },
          "CreatedBy": { "type": "string", "maxLength": 12, "description": "Created by user. Read-only." },
          "LastChangedAt": { "type": "string", "format": "date-time", "description": "Last modification timestamp. Read-only." },
          "LastChangedBy": { "type": "string", "maxLength": 12, "description": "Last modified by user. Read-only." }
        }
      },
      "LinkedBPAssignmentCreate": {
        "type": "object",
        "description": "Payload for creating a linked Business Partner assignment. All three fields are mandatory.",
        "required": ["Linkedbusinesspartner", "Linkedbusinesspartnername", "LogicalSystem"],
        "properties": {
          "Linkedbusinesspartner": { "type": "string", "maxLength": 10, "description": "Business Partner number to link." },
          "Linkedbusinesspartnername": { "type": "string", "maxLength": 80, "description": "Name of the linked Business Partner." },
          "LogicalSystem": { "type": "string", "maxLength": 10, "description": "Logical system identifier. Must be valid." }
        }
      },
      "LinkedBPAssignmentUpdate": {
        "type": "object",
        "description": "Payload for updating a linkage. Only send fields you want to change. LogicalSystem must be a valid configured value.",
        "properties": {
          "Linkedbusinesspartner": { "type": "string", "maxLength": 10 },
          "Linkedbusinesspartnername": { "type": "string", "maxLength": 80 },
          "LogicalSystem": { "type": "string", "maxLength": 10 }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
